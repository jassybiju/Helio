<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <title>Appointment Details</title>

    <style>
        * {
            box-sizing: border-box;
            font-family: Arial, Helvetica, sans-serif;
        }

        body {
            margin: 40px;
            color: #222;
            font-size: 14px;
        }

        h1 {
            margin: 0;
            font-size: 28px;
        }

        h2 {
            margin-top: 35px;
            margin-bottom: 12px;
            border-bottom: 1px solid #ddd;
            padding-bottom: 6px;
            font-size: 18px;
        }

        table {
            width: 100%;
            border-collapse: collapse;
        }

        th,
        td {
            text-align: left;
            border: 1px solid #ddd;
            padding: 10px;
        }

        th {
            background: #f5f5f5;
            width: 30%;
        }

        .header {
            display: flex;
            justify-content: space-between;
            margin-bottom: 35px;
            border-bottom: 2px solid #444;
            padding-bottom: 20px;
        }

        .section {
            margin-bottom: 30px;
        }

        .prescriptions table th {
            width: auto;
        }

        .footer {
            margin-top: 60px;
            text-align: center;
            font-size: 12px;
            color: gray;
        }
    </style>
</head>

<body>

<div class="header">
    <div>
        <h1>Appointment Report</h1>
        <p><strong>Appointment ID:</strong> {{appointment.id}}</p>
    </div>

    <div>
        <strong>Date:</strong> {{appointment.date}}
    </div>
</div>

<div class="section">
    <h2>Patient Details</h2>

    <table>
        <tr>
            <th>Name</th>
            <td>{{patient.name}}</td>
        </tr>

        <tr>
            <th>Patient ID</th>
            <td>{{patient.id}}</td>
        </tr>

        <tr>
            <th>Age</th>
            <td>{{patient.age}}</td>
        </tr>

        <tr>
            <th>Gender</th>
            <td>{{patient.gender}}</td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>Doctor Details</h2>

    <table>
        <tr>
            <th>Name</th>
            <td>{{doctor.name}}</td>
        </tr>

        <tr>
            <th>Doctor ID</th>
            <td>{{doctor.id}}</td>
        </tr>

        <tr>
            <th>Specialty</th>
            <td>{{doctor.specialty}}</td>
        </tr>
    </table>
</div>

<div class="section">
    <h2>Appointment Information</h2>

    <table>

        <tr>
            <th>Status</th>
            <td>{{appointment.status}}</td>
        </tr>

        <tr>
            <th>Consultation Type</th>
            <td>{{appointment.consultationType}}</td>
        </tr>

        <tr>
            <th>Time</th>
            <td>{{appointment.startTime}} - {{appointment.endTime}}</td>
        </tr>

        <tr>
            <th>Consultation Fee</th>
            <td>₹ {{appointment.consultationFee}}</td>
        </tr>

        <tr>
            <th>Platform Fee</th>
            <td>₹ {{appointment.platformFee}}</td>
        </tr>

        <tr>
            <th>Total Amount</th>
            <td>₹ {{appointment.totalAmount}}</td>
        </tr>

        <tr>
            <th>Payment Status</th>
            <td>{{appointment.paymentStatus}}</td>
        </tr>

    </table>
</div>

{{#if consultation}}

<div class="section">
    <h2>Consultation Summary</h2>

    <table>

        <tr>
            <th>Started At</th>
            <td>{{consultation.startedAt}}</td>
        </tr>

        <tr>
            <th>Ended At</th>
            <td>{{consultation.endedAt}}</td>
        </tr>

        <tr>
            <th>Primary Diagnosis</th>
            <td>{{consultation.primaryDiagnosis}}</td>
        </tr>

        <tr>
            <th>Clinical Observation</th>
            <td>{{consultation.clinicalObservation}}</td>
        </tr>

        <tr>
            <th>General Advice</th>
            <td>{{consultation.generalAdvice}}</td>
        </tr>

        <tr>
            <th>Quick Note</th>
            <td>{{consultation.quickNote}}</td>
        </tr>

        <tr>
            <th>Medication Period</th>
            <td>{{consultation.medicationPeriod}} Days</td>
        </tr>

    </table>
</div>

{{#if consultation.vitals}}

<div class="section">
    <h2>Vitals</h2>

    <table>

        <tr>
            <th>Height</th>
            <td>{{consultation.vitals.height}} cm</td>
        </tr>

        <tr>
            <th>Weight</th>
            <td>{{consultation.vitals.weight}} kg</td>
        </tr>

        <tr>
            <th>Temperature</th>
            <td>{{consultation.vitals.temperature}} °C</td>
        </tr>

        <tr>
            <th>Blood Pressure</th>
            <td>{{consultation.vitals.bloodPressure}}</td>
        </tr>

        <tr>
            <th>Pulse Rate</th>
            <td>{{consultation.vitals.pulseRate}} bpm</td>
        </tr>

        <tr>
            <th>SpO₂</th>
            <td>{{consultation.vitals.spo2}} %</td>
        </tr>

    </table>
</div>

{{/if}}

{{#if consultation.prescriptions.length}}

<div class="section prescriptions">
    <h2>Prescriptions</h2>

    <table>

        <thead>

        <tr>
            <th>Medicine</th>
            <th>Food Timing</th>
            <th>Schedule</th>
            <th>Duration</th>
            <th>Instructions</th>
        </tr>

        </thead>

        <tbody>

        {{#each consultation.prescriptions}}

        <tr>
            <td>{{name}}</td>
            <td>{{foodTiming}}</td>
            <td>{{timings}}</td>
            <td>{{duration}}</td>
            <td>{{instructions}}</td>
        </tr>

        {{/each}}

        </tbody>

    </table>
</div>

{{/if}}

{{/if}}

<div class="footer">
    Generated by Helixo Telemedicine Platform
</div>

</body>
</html>